#!/bin/sh
# Removes Oxide's APT source and key when the package is purged. A plain `apt remove` keeps them,
# so reinstalling needs no setup. Runs as root and deletes only /etc/apt/sources.list.d/oxide.list
# (when it is still the line the package or the documented setup wrote) and /usr/share/keyrings/oxide.gpg
# (when no source still uses it).
set -e

[ "$1" = purge ] || exit 0

KEYRING=/usr/share/keyrings/oxide.gpg
SOURCE=/etc/apt/sources.list.d/oxide.list
LINE='deb [signed-by=/usr/share/keyrings/oxide.gpg] https://github.com/getoxide/oxide/releases/latest/download/ ./'

if [ -f "$SOURCE" ] && [ ! -L "$SOURCE" ] && printf '%s\n' "$LINE" | cmp -s - "$SOURCE"; then
  rm -f "$SOURCE"
fi
if ! grep -qsF "$KEYRING" /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; then
  rm -f "$KEYRING"
fi
exit 0
